---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="WolfCanvas — Websites That Turn Property Visitors Into Buyers">
  <Navbar />
  <main>
    <!-- ============================================ -->
    <!-- HERO — Dark gradient + grid + glow + noise -->
    <!-- ============================================ -->
    <section class="relative pt-40 md:pt-44 pb-16 px-6 overflow-hidden" style="background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #0F172A 100%);">
      <!-- Noise texture removed for mobile performance -->
      <!-- Radial glow behind content -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[700px] bg-accent-indigo/10 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-1/4 w-[500px] h-[400px] bg-accent-cyan/8 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="relative max-w-6xl mx-auto z-10 lg:flex lg:items-start lg:gap-10 xl:gap-14">
        <div class="flex-1 min-w-0 max-w-xl xl:max-w-2xl">
          <h1 fetchpriority="high" class="font-headline font-bold text-4xl md:text-5xl lg:text-6xl leading-[1.15] tracking-tight text-white mb-6 reveal" style="font-family: 'Merriweather', Georgia, serif">
            Websites That Turn Property Visitors Into Qualified Buyer Enquiries
          </h1>

          <p class="text-lg md:text-xl font-body text-white/60 leading-relaxed mb-10 max-w-2xl reveal">
            Conversion-focused websites and landing pages built for real estate brokerages that rely on digital enquiries.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 reveal">
            <a href="/apply" class="btn-primary inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-accent-indigo text-white font-semibold rounded-lg">
              Review My Website
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <a href="/work" class="inline-flex items-center gap-1 text-sm text-white/50 underline underline-offset-[3px] hover:text-white/70 transition-colors">
              View live projects
            </a>
          </div>
          <p class="text-sm text-white/40 mt-2 reveal">Free &bull; takes 10 minutes &bull; no commitment</p>
          <p class="text-sm font-medium text-white/60 mt-16 reveal">Real-estate-focused &bull; Sub-1.5s performance target &bull; WhatsApp-ready workflows</p>
        </div>

        <div class="hidden lg:block shrink-0 w-[48%] max-w-[560px] -mt-10 -mb-32 browser-frame-wrap">
          <div class="browser-frame">
            <div class="browser-topbar">
              <div class="browser-dots">
                <span class="dot-red"></span>
                <span class="dot-yellow"></span>
                <span class="dot-green"></span>
              </div>
              <div class="browser-title">dwelledge.in</div>
            </div>
            <div class="browser-body">
              <img src="/HEROdwelledge.webp" alt="dwelledge.in" loading="lazy" decoding="async" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- FUNNEL — Dark section -->
    <!-- ============================================ -->
    <section class="py-20 px-6" style="background: linear-gradient(180deg, #0F172A 0%, #1E1B4B 100%);">
      <div class="max-w-5xl mx-auto">
        <p class="text-xs font-mono uppercase tracking-widest text-white/30 text-center mb-12 reveal">How the system works</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="hero-stagger text-center">
            <div class="w-14 h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <span class="block font-semibold text-sm text-white/80 mb-1">Property visitor</span>
            <span class="text-xs text-white/40">Finds your listing</span>
          </div>
          <div class="hero-stagger text-center">
            <div class="w-14 h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>
            </div>
            <span class="block font-semibold text-sm text-white/80 mb-1">Conversion page</span>
            <span class="text-xs text-white/40">Converts interest</span>
          </div>
          <div class="hero-stagger text-center">
            <div class="w-14 h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-accent-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <span class="block font-semibold text-sm text-white/80 mb-1">Qualified enquiry</span>
            <span class="text-xs text-white/40">Filters serious buyers</span>
          </div>
          <div class="hero-stagger text-center">
            <div class="w-14 h-14 rounded-2xl bg-white/[0.06] border border-white/[0.08] flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-accent-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>
            </div>
            <span class="block font-semibold text-sm text-white/80 mb-1">Instant handoff</span>
            <span class="text-xs text-white/40">Instant handoff</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- PAIN — Light section with gradient fade -->
    <!-- ============================================ -->
    <section class="py-24 px-6 bg-white" style="content-visibility:auto">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12 reveal">
          <span class="text-xs font-mono uppercase tracking-[0.2em] text-accent-muted mb-4 block">The problem</span>
          <h2 class="font-headline font-bold text-3xl md:text-4xl tracking-tight text-slate-900 mb-4 max-w-2xl">
            Most real estate websites leak enquiries in three places
          </h2>
          <p class="text-slate-500 text-lg max-w-2xl">
            You're already paying for traffic. The problem is that many buyers leave before they submit an enquiry.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="p-6 rounded-xl border border-slate-200 bg-white card-lift reveal">
            <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20a8 8 0 100-16 8 8 0 000 16z" /><path d="M12 12V8" /><path d="M12 12l3.5-2" /></svg>
            </div>
            <h3 class="font-headline font-bold text-lg text-slate-900 mb-2">Slow pages</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Buyers leave before listings and forms finish loading. Every second of delay increases the chance a buyer leaves before the page finishes loading.</p>
          </div>
          <div class="p-6 rounded-xl border border-slate-200 bg-white card-lift reveal">
            <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" /><path d="M14 2v6h6" /><path d="M9 15l6-6M9 9l6 6" /></svg>
            </div>
            <h3 class="font-headline font-bold text-lg text-slate-900 mb-2">Weak forms</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Generic forms attract low-quality enquiries and collect incomplete information, making it harder for your team to qualify buyers.</p>
          </div>
          <div class="p-6 rounded-xl border border-slate-200 bg-white card-lift reveal">
            <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l3 3" /></svg>
            </div>
            <h3 class="font-headline font-bold text-lg text-slate-900 mb-2">Delayed follow-up</h3>
            <p class="text-sm text-slate-500 leading-relaxed">Hot leads go cold while agents manually route and respond. The longer a lead waits for a response, the lower the chance of a conversation.</p>
          </div>
        </div>
        <p class="text-sm text-slate-400 italic mt-8 reveal">If you're already paying for traffic, improving conversion is usually cheaper than buying more clicks.</p>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- SYSTEM — Dark section (amplified gradient) -->
    <!-- ============================================ -->
    <section class="py-24 px-6" style="background: linear-gradient(180deg, #0F172A 0%, #1E1B4B 50%, #0F172A 100%);content-visibility:auto">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12 reveal">
          <span class="text-xs font-mono uppercase tracking-[0.2em] text-accent-cyan mb-4 block">The system</span>
          <h2 class="font-headline font-bold text-3xl md:text-4xl tracking-tight text-white mb-4">
            The Property Conversion System
          </h2>
          <p class="text-white/50 text-lg max-w-2xl">
            A complete system designed to turn your website traffic into qualified buyer enquiries — automatically.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="p-6 rounded-xl bg-white/[0.04] border border-white/[0.08] card-lift reveal">
            <div class="w-10 h-10 rounded-lg bg-white/[0.08] flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
            </div>
            <h3 class="font-headline font-bold text-lg text-white mb-2">Conversion-focused pages</h3>
            <p class="text-sm text-white/50 leading-relaxed">Every page has one goal: get the visitor to submit an enquiry. No distractions, no dead ends.</p>
          </div>
          <div class="p-6 rounded-xl bg-white/[0.04] border border-white/[0.08] card-lift reveal">
            <div class="w-10 h-10 rounded-lg bg-accent-cyan/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-accent-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
            </div>
            <h3 class="font-headline font-bold text-lg text-white mb-2">Mobile-first UX</h3>
            <p class="text-sm text-white/50 leading-relaxed">80%+ of property searches happen on phones. We design for thumb-reach and zero friction.</p>
          </div>
          <div class="p-6 rounded-xl bg-white/[0.04] border border-white/[0.08] card-lift reveal">
            <div class="w-10 h-10 rounded-lg bg-white/[0.08] flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="font-headline font-bold text-lg text-white mb-2">Lead qualification</h3>
            <p class="text-sm text-white/50 leading-relaxed">Forms ask the right questions — budget, timeline, location — so your team talks to serious buyers only.</p>
          </div>
          <div class="p-6 rounded-xl bg-white/[0.04] border border-white/[0.08] card-lift reveal">
            <div class="w-10 h-10 rounded-lg bg-green-500/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-green-400" fill="none" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>
            <h3 class="font-headline font-bold text-lg text-white mb-2">WhatsApp routing</h3>
            <p class="text-sm text-white/50 leading-relaxed">Enquiry submitted, WhatsApp pings the agent instantly. Response time drops from hours to minutes.</p>
          </div>
        </div>

        <div class="mt-6 p-6 rounded-xl bg-white/[0.04] border border-white/[0.08] card-lift reveal">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-lg bg-white/[0.08] flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            </div>
            <div>
              <h3 class="font-headline font-bold text-lg text-white mb-1">Tracking setup</h3>
              <p class="text-sm text-white/50 leading-relaxed">Meta Pixel, Google Analytics, and conversion tracking installed from day one. You'll be able to see which pages and campaigns are generating enquiries.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================ -->
    <!-- WORK — Light section -->
    <!-- ============================================ -->
    <section class="py-24 px-6 bg-white" style="content-visibility:auto">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12 gap-6 reveal">
          <div>
            <h2 class="font-headline font-bold text-3xl md:text-4xl tracking-tight text-slate-900 mb-3">Selected work</h2>
            <p class="text-slate-500 text-lg">A few examples of the type of conversion-focused real estate websites we build.</p>
          </div>
          <a href="/work" class="inline-flex items-center gap-2 text-sm font-medium text-accent-muted hover:text-accent-muted/80 transition-colors group shrink-0">
            View all work
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="rounded-2xl border border-slate-200 overflow-hidden bg-white card-lift reveal">
            <div class="aspect-[16/10] relative overflow-hidden bg-slate-100">
              <img src="/dreamhomes-hero.webp" alt="DreamHomes India" width="1920" height="1200" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
              <div class="absolute top-4 left-4 px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-semibold text-accent-muted shadow-sm">Live</div>
            </div>
            <div class="p-6">
              <h3 class="font-headline font-bold text-lg text-slate-900 mb-2">DreamHomes India</h3>
              <p class="text-sm text-slate-500 mb-4">Complete website redesign with conversion-focused property listings and WhatsApp enquiry routing for an NCR brokerage.</p>
              <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-accent-cyan/10 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-cyan"></span>
                <span class="text-xs font-medium text-accent-cyan/80">Conversion-focused redesign</span>
              </div>
            </div>
          </div>
          <div class="rounded-2xl border border-slate-200 overflow-hidden bg-white card-lift reveal">
            <div class="aspect-[16/10] relative overflow-hidden bg-slate-100">
              <img src="/prestigehomes-hero.webp" alt="Prestige Homes" width="1920" height="1200" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
              <div class="absolute top-4 left-4 px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-semibold text-accent-cyan shadow-sm">Live</div>
            </div>
            <div class="p-6">
              <h3 class="font-headline font-bold text-lg text-slate-900 mb-2">Prestige Homes</h3>
              <p class="text-sm text-slate-500 mb-4">Lead qualification landing page system for Google Ads campaigns targeting luxury buyers.</p>
              <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-accent-muted/10 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-accent-muted"></span>
                <span class="text-xs font-medium text-accent-muted/80">Faster mobile experience</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <!-- ============================================ -->
    <section class="py-6 border-y border-brand-border overflow-hidden" style="background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 50%, #F8FAFC 100%);content-visibility:auto">
      <div class="trust-marquee flex gap-20 items-center">
        <div class="trust-marquee-track flex gap-20 items-center shrink-0">
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-accent-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            <span class="text-sm font-medium text-slate-800 whitespace-nowrap">Real estate focused</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-4 h-4 text-accent-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            <span class="text-sm font-medium text-slate-800 whitespace-nowrap">&lt;1.5s load time</span>
          </div>
          <div class="flex items-center gap-3">
