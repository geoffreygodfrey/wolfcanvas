---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Stop Losing Enquiries Through Bad Forms — WolfCanvas">
  <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-white/10">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 font-headline font-bold text-lg text-white tracking-tight">
        <div class="w-8 h-8 rounded-md bg-white/10 flex items-center justify-center text-white/60 text-xs font-bold">W</div>
        WolfCanvas
      </a>
      <a href="/apply" class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-indigo text-white text-sm font-semibold rounded-lg hover:bg-accent-indigo/90 transition-colors">
        Apply for a Project
      </a>
    </div>
  </nav>

  <main class="pt-24 pb-24 px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Hero -->
      <div class="max-w-3xl mb-20">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-red-500/10 rounded-full mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse"></span>
          <span class="text-xs font-medium text-red-400">Lead Leakage</span>
        </div>
        <h1 class="font-headline font-extrabold text-4xl md:text-5xl lg:text-6xl leading-[1.1] tracking-tight text-white mb-6">
          Stop losing enquiries through bad forms
        </h1>
        <p class="text-lg md:text-xl text-white/50 leading-relaxed mb-10">
          Generic contact forms attract tyre-kickers and miss the qualification data your agents need. Every bad enquiry costs your team 15 minutes they could spend closing deals.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/apply" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-accent-indigo text-white font-semibold rounded-lg hover:bg-accent-indigo/90 transition-colors">
            Apply for a Project
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>

      <!-- Form -->
      <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-8 md:p-10 max-w-2xl mb-20">
        <h2 class="font-headline font-bold text-2xl text-white mb-2">Get a form audit</h2>
        <p class="text-sm text-white/40 mb-8">We'll review your current enquiry flow and show you where leads are leaking.</p>

        <form name="lead-audit" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-5">
          <input type="hidden" name="form-name" value="lead-audit" />
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <div class="grid sm:grid-cols-2 gap-4">
            <input type="text" name="name" required placeholder="Your name" class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all text-sm" />
            <input type="email" name="email" required placeholder="Email address" class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all text-sm" />
          </div>
          <input type="url" name="website" required placeholder="Your website URL" class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all text-sm" />

          <button type="submit" class="w-full py-3.5 bg-accent-indigo text-white font-semibold rounded-lg hover:bg-accent-indigo/90 transition-colors">
            Request Form Audit
          </button>
          <p class="text-xs text-white/30 text-center">We respond within 24 hours with your audit results.</p>
        </form>
      </div>

      <!-- Testimonial -->
      <div class="max-w-2xl mb-16">
        <blockquote class="text-xl md:text-2xl font-headline font-medium leading-relaxed text-white mb-6">
          "We were getting 50 enquiries a month but only closing 2 deals. After WolfCanvas rebuilt our forms, we closed 8 from the same traffic."
        </blockquote>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-accent-cyan/20 flex items-center justify-center text-accent-cyan font-bold text-sm">AD</div>
          <div>
            <span class="block text-sm font-semibold text-white">Anita Desai</span>
            <span class="text-xs text-white/40">Marketing Head, Prestige Homes</span>
          </div>
        </div>
      </div>

      <!-- Proof visual -->
      <div class="p-8 rounded-2xl border border-white/10 bg-white/[0.04]">
        <p class="text-xs font-mono uppercase tracking-widest text-white/40 mb-4">Before / After</p>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="p-6 rounded-xl bg-red-500/10 border border-red-500/20">
            <span class="text-xs font-semibold text-red-400 uppercase tracking-wider">Before</span>
            <div class="mt-3 space-y-2">
              <div class="text-2xl font-bold text-red-400">3 fields</div>
              <div class="text-sm text-red-400/80">No qualification data</div>
              <div class="text-sm text-red-400/80">4% close rate</div>
            </div>
          </div>
          <div class="p-6 rounded-xl bg-accent-cyan/10 border border-accent-cyan/20">
            <span class="text-xs font-semibold text-accent-cyan uppercase tracking-wider">After</span>
            <div class="mt-3 space-y-2">
              <div class="text-2xl font-bold text-accent-cyan">7 fields</div>
              <div class="text-sm text-accent-cyan/80">Budget + timeline + source</div>
              <div class="text-sm text-accent-cyan/80">16% close rate</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

</Layout>
