---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Instant WhatsApp Lead Routing — WolfCanvas">
  <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-md border-b border-white/10">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5 font-headline font-bold text-lg text-white tracking-tight">
        <div class="w-8 h-8 rounded-md bg-white/10 flex items-center justify-center text-white/60 text-xs font-bold">W</div>
        WolfCanvas
      </a>
      <a href="/apply" class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent-indigo text-white text-sm font-semibold rounded-lg hover:bg-accent-indigo/90 transition-colors">
        Apply for a Project
      </a>
    </div>
  </nav>

  <main class="pt-24 pb-24 px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Hero -->
      <div class="max-w-3xl mb-20">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-accent-cyan/10 rounded-full mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-cyan animate-pulse"></span>
          <span class="text-xs font-medium text-accent-cyan">Automation</span>
        </div>
        <h1 class="font-headline font-extrabold text-4xl md:text-5xl lg:text-6xl leading-[1.1] tracking-tight text-white mb-6">
          Instant WhatsApp lead routing
        </h1>
        <p class="text-lg md:text-xl text-white/50 leading-relaxed mb-10">
          Your enquiry form submits. Within 3 seconds, the lead gets a WhatsApp message, your agent gets notified, and the data lands in Google Sheets. No manual routing. No cold leads.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/apply" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-accent-indigo text-white font-semibold rounded-lg hover:bg-accent-indigo/90 transition-colors">
            Apply for a Project
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>

      <!-- Form -->
      <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-8 md:p-10 max-w-2xl mb-20">
        <h2 class="font-headline font-bold text-2xl text-white mb-2">See how it works</h2>
        <p class="text-sm text-white/40 mb-8">We'll walk you through a live demo of the WhatsApp routing system.</p>

        <form name="automation-demo" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-5">
          <input type="hidden" name="form-name" value="automation-demo" />
          <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>

          <div class="grid sm:grid-cols-2 gap-4">
            <input type="text" name="name" required placeholder="Your name" class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all text-sm" />
            <input type="email" name="email" required placeholder="Email address" class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all text-sm" />
          </div>
          <input type="tel" name="whatsapp" required placeholder="WhatsApp number (for demo)" class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all text-sm" />

          <button type="submit" class="w-full py-3.5 bg-accent-indigo text-white font-semibold rounded-lg hover:bg-accent-indigo/90 transition-colors">
            Request Live Demo
          </button>
          <p class="text-xs text-white/30 text-center">We'll send you a test enquiry through the system within 24 hours.</p>
        </form>
      </div>

      <!-- Testimonial -->
      <div class="max-w-2xl mb-16">
        <blockquote class="text-xl md:text-2xl font-headline font-medium leading-relaxed text-white mb-6">
          "Our agents used to check the website for new enquiries twice a day. Now WhatsApp pings them the second someone submits. Response time went from 4 hours to 8 minutes."
        </blockquote>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-white/[0.08] flex items-center justify-center text-white/50 font-bold text-sm">VK</div>
          <div>
            <span class="block text-sm font-semibold text-white">Vikram Kumar</span>
            <span class="text-xs text-white/40">Operations Lead, Prestige Homes</span>
          </div>
        </div>
      </div>

      <!-- Proof visual - Flow diagram -->
      <div class="p-8 rounded-2xl border border-white/10 bg-white/[0.04]">
        <p class="text-xs font-mono uppercase tracking-widest text-white/40 mb-6">Automation Flow</p>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="p-4 rounded-xl bg-white/[0.04] text-center">
            <div class="text-2xl mb-2">📝</div>
            <span class="block text-sm font-semibold text-white">Form Submit</span>
            <span class="text-xs text-white/40">Lead fills form</span>
          </div>
          <div class="p-4 rounded-xl bg-white/[0.04] text-center">
            <div class="text-2xl mb-2">⚡</div>
            <span class="block text-sm font-semibold text-white">Webhook Fires</span>
            <span class="text-xs text-white/40">Data processed</span>
          </div>
          <div class="p-4 rounded-xl bg-accent-cyan/10 text-center">
            <div class="text-2xl mb-2">💬</div>
            <span class="block text-sm font-semibold text-white">WhatsApp Sent</span>
            <span class="text-xs text-white/40">Lead + agent notified</span>
          </div>
          <div class="p-4 rounded-xl bg-accent-cyan/10 text-center">
            <div class="text-2xl mb-2">📊</div>
            <span class="block text-sm font-semibold text-white">Sheets Updated</span>
            <span class="text-xs text-white/40">CRM data logged</span>
          </div>
        </div>
      </div>
    </div>
  </main>

</Layout>
