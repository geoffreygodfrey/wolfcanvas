---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Apply — WolfCanvas">
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="relative pt-40 md:pt-44 pb-24 px-6 overflow-hidden" style="background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #0F172A 100%);">
      <!-- Noise removed for mobile performance -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[700px] bg-accent-indigo/10 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-1/4 w-[500px] h-[400px] bg-accent-cyan/8 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="relative max-w-2xl mx-auto z-10">
        <div class="mb-12">
          <p class="text-xs font-mono uppercase tracking-widest text-accent-cyan mb-3">Apply</p>
          <h1 class="font-headline font-bold text-4xl md:text-5xl tracking-tight text-white mb-4">Tell us about your project</h1>
          <p class="text-white/50 text-lg">
            We review every application personally and reply within 24 hours.
          </p>
        </div>

        <form
          name="apply"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-6"
        >
          <input type="hidden" name="form-name" value="apply" />
          <p class="hidden">
            <label>Don't fill this out: <input name="bot-field" /></label>
          </p>

          <div>
            <label class="block text-sm font-medium text-white/70 mb-2">Name *</label>
            <input type="text" name="name" required placeholder="Your full name" class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all" />
          </div>

          <div>
            <label class="block text-sm font-medium text-white/70 mb-2">Brokerage / Company *</label>
            <input type="text" name="company" required placeholder="Your brokerage or company name" class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all" />
          </div>

          <div>
            <label class="block text-sm font-medium text-white/70 mb-2">Website URL *</label>
            <input type="url" name="website" required placeholder="https://yoursite.com" class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all" />
          </div>

          <div>
            <label class="block text-sm font-medium text-white/70 mb-2">What's the main problem right now? *</label>
            <div class="flex flex-wrap gap-2">
              <label class="relative cursor-pointer">
                <input type="checkbox" name="problem[]" value="low-quality" class="peer sr-only" />
                <div class="px-3.5 py-2 text-xs font-medium rounded-full border border-white/10 text-white/50 peer-checked:border-accent-muted peer-checked:bg-accent-muted/10 peer-checked:text-accent-muted transition-all">Low enquiry quality</div>
              </label>
              <label class="relative cursor-pointer">
                <input type="checkbox" name="problem[]" value="slow-website" class="peer sr-only" />
                <div class="px-3.5 py-2 text-xs font-medium rounded-full border border-white/10 text-white/50 peer-checked:border-accent-muted peer-checked:bg-accent-muted/10 peer-checked:text-accent-muted transition-all">Slow website</div>
              </label>
              <label class="relative cursor-pointer">
                <input type="checkbox" name="problem[]" value="mobile" class="peer sr-only" />
                <div class="px-3.5 py-2 text-xs font-medium rounded-full border border-white/10 text-white/50 peer-checked:border-accent-muted peer-checked:bg-accent-muted/10 peer-checked:text-accent-muted transition-all">Poor mobile experience</div>
              </label>
              <label class="relative cursor-pointer">
                <input type="checkbox" name="problem[]" value="too-many-whatsapp" class="peer sr-only" />
                <div class="px-3.5 py-2 text-xs font-medium rounded-full border border-white/10 text-white/50 peer-checked:border-accent-muted peer-checked:bg-accent-muted/10 peer-checked:text-accent-muted transition-all">Too many WhatsApp enquiries</div>
              </label>
              <label class="relative cursor-pointer">
                <input type="checkbox" name="problem[]" value="not-enough" class="peer sr-only" />
                <div class="px-3.5 py-2 text-xs font-medium rounded-full border border-white/10 text-white/50 peer-checked:border-accent-muted peer-checked:bg-accent-muted/10 peer-checked:text-accent-muted transition-all">Not getting enough enquiries</div>
              </label>
              <label class="relative cursor-pointer">
                <input type="checkbox" name="problem[]" value="redesign" class="peer sr-only" />
                <div class="px-3.5 py-2 text-xs font-medium rounded-full border border-white/10 text-white/50 peer-checked:border-accent-muted peer-checked:bg-accent-muted/10 peer-checked:text-accent-muted transition-all">Need a redesign</div>
              </label>
              <label class="relative cursor-pointer">
                <input type="checkbox" name="problem[]" value="other" class="peer sr-only" />
                <div class="px-3.5 py-2 text-xs font-medium rounded-full border border-white/10 text-white/50 peer-checked:border-accent-muted peer-checked:bg-accent-muted/10 peer-checked:text-accent-muted transition-all">Other</div>
              </label>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-white/70 mb-2">Anything else we should know? (optional)</label>
            <textarea name="notes" rows="3" placeholder="Tell us more about your project..." class="w-full px-4 py-3 rounded-lg border border-white/10 bg-white/[0.04] text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all resize-none"></textarea>
          </div>

          <button type="submit" class="w-full py-3.5 bg-accent-indigo text-white font-semibold rounded-lg hover:bg-accent-indigo/90 transition-colors flex items-center justify-center gap-2">
            Submit application
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </button>

          <p class="text-xs text-white/30 text-center">
            No spam. No sales pressure. Every application is reviewed by a real person.
          </p>
        </form>

        <!-- Success message -->
        <div id="success-message" class="hidden text-center py-12">
          <div class="w-16 h-16 rounded-full bg-green-500/20 flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          </div>
          <h2 class="font-headline font-bold text-2xl text-white mb-4">Thanks for reaching out.</h2>
          <p class="text-white/60 leading-relaxed max-w-md mx-auto mb-4">
            We'll review your website and project details personally.
          </p>
          <p class="text-white/60 leading-relaxed max-w-md mx-auto mb-4">
            If we believe we can genuinely improve your enquiry conversion, we'll get back to you within 24 hours to arrange a short project review.
          </p>
          <p class="text-white/60 leading-relaxed max-w-md mx-auto mb-8">
            If we don't think we're the right fit, we'll let you know upfront.
          </p>
          <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-accent-muted hover:text-accent-muted/80 transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15m0 0l6.75 6.75M4.5 12l6.75-6.75" /></svg>
            Back to homepage
          </a>
          <p class="text-xs text-white/30 mt-8">No spam. No sales pressure. Every application is reviewed by a real person.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  if (params.get('success') === 'true') {
    document.getElementById('success-message').classList.remove('hidden');
    document.querySelector('form').classList.add('hidden');
  }
</script>
