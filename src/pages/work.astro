---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const projects = [
  {
    name: 'DreamHomes India',
    type: 'Full Website Redesign',
    metric: 'Load time: 6.2s → 1.3s',
    description: 'Complete redesign of a mid-size real estate brokerage website serving the NCR region. Replaced a slow WordPress theme with a custom Astro build. Added WhatsApp enquiry routing and lead qualification forms on every property listing.',
    tags: ['Astro', 'Tailwind', 'WhatsApp API', 'Google Sheets'],
    accent: 'indigo',
    image: '/dreamhomes macbook frame.webp',
    link: 'https://dreamhomesindia.vercel.app/',
  },
  {
    name: 'Prestige Homes',
    type: 'Landing Page System',
    metric: '43% increase in qualified enquiries',
    description: 'Built a set of ad-specific landing pages for Google Ads campaigns targeting luxury buyers. Each page has a qualification form above the fold, one testimonial, and instant WhatsApp handoff.',
    tags: ['Astro', 'Netlify Forms', 'Meta Pixel', 'Google Ads'],
    accent: 'cyan',
    image: '/prestigehomes ios and mac.webp',
    link: 'https://prestigehomes-five.vercel.app/index.html',
  },
];
---

<Layout title="Work — WolfCanvas">
  <Navbar />
  <main>
    <!-- Hero -->
    <section class="relative pt-40 md:pt-44 pb-24 px-6 overflow-hidden" style="background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #0F172A 100%);">
      <!-- Noise removed for mobile performance -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[700px] bg-accent-indigo/10 rounded-full blur-[140px] pointer-events-none"></div>
      <div class="absolute bottom-0 right-1/4 w-[500px] h-[400px] bg-accent-cyan/8 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="relative max-w-6xl mx-auto z-10">
        <div class="mb-16">
          <h1 class="font-headline font-bold text-4xl md:text-5xl tracking-tight text-white mb-4">Live projects</h1>
          <p class="text-white/50 text-lg max-w-xl">
            Real websites built for real brokerages. Each one designed to convert property visitors into qualified buyer enquiries.
          </p>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="py-24 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="space-y-12">
          {projects.map((project, i) => (
            <div class="rounded-2xl border border-slate-200 overflow-hidden bg-white">
              <div class={`aspect-[21/9] ${project.accent === 'indigo' ? 'bg-gradient-to-br from-accent-indigo/5 via-accent-indigo/[0.02] to-white' : 'bg-gradient-to-br from-accent-cyan/5 via-accent-cyan/[0.02] to-white'} relative overflow-hidden`}>
                <img src={project.image} alt={project.name} width="1920" height="823" loading="lazy" decoding="async" class="w-full h-full object-contain object-center p-4" />

              </div>
              <div class="p-8 md:p-10">
                <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span class="px-3 py-1 bg-slate-50 rounded-full text-xs font-semibold text-slate-600">{project.type}</span>
                  <span class={`px-3 py-1 rounded-full text-xs font-semibold ${project.accent === 'indigo' ? 'bg-accent-muted/10 text-accent-muted' : 'bg-accent-cyan/10 text-accent-cyan'}`}>{project.metric}</span>
                </div>
                <h2 class="font-headline font-bold text-2xl md:text-3xl text-slate-900 mb-4">{project.name}</h2>
                <p class="text-slate-500 leading-relaxed mb-6 max-w-2xl">{project.description}</p>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map(tag => (
                    <span class="px-3 py-1.5 text-xs font-mono rounded-md bg-slate-50 text-slate-500 border border-slate-200">{tag}</span>
                  ))}
                </div>
                {project.link && (
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-muted hover:text-accent-muted/80 transition-colors">
                    Visit live site
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>

        <!-- Other projects -->
        <div class="mt-20 pt-20 border-t border-slate-200">
          <h3 class="font-headline font-bold text-2xl text-slate-900 mb-6">Other projects</h3>
          <div class="space-y-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <a href="http://stechinterior.store" target="_blank" rel="noopener noreferrer" class="font-headline font-bold text-lg text-accent-muted hover:text-accent-muted/80 transition-colors">S-Tech Interior</a>
                <p class="text-sm text-slate-500 mt-1">Live storefront built with React and TypeScript for an interior design firm.</p>
              </div>
              <a href="http://stechinterior.store" target="_blank" rel="noopener noreferrer" class="shrink-0 text-xs font-medium text-accent-muted hover:text-accent-muted/80 transition-colors">Visit →</a>
            </div>
            <div class="flex items-start justify-between gap-4">
              <div>
                <a href="http://BodhaMantra.life" target="_blank" rel="noopener noreferrer" class="font-headline font-bold text-lg text-accent-muted hover:text-accent-muted/80 transition-colors">BodhaMantra</a>
                <p class="text-sm text-slate-500 mt-1">Multi-role platform where students connect with live mentors for ₹49/session. Built with role-based auth (Admin, Teacher, Student).</p>
              </div>
              <a href="http://BodhaMantra.life" target="_blank" rel="noopener noreferrer" class="shrink-0 text-xs font-medium text-accent-muted hover:text-accent-muted/80 transition-colors">Visit →</a>
            </div>
            <div class="flex items-start justify-between gap-4">
              <div>
                <a href="https://beta.nilescart.com" target="_blank" rel="noopener noreferrer" class="font-headline font-bold text-lg text-accent-muted hover:text-accent-muted/80 transition-colors">NilesCart</a>
                <p class="text-sm text-slate-500 mt-1">E-commerce platform currently in beta. Full shopping experience with product catalog, cart, and checkout flow.</p>
              </div>
              <a href="https://beta.nilescart.com" target="_blank" rel="noopener noreferrer" class="shrink-0 text-xs font-medium text-accent-muted hover:text-accent-muted/80 transition-colors">Visit →</a>
            </div>
          </div>
        </div>

        <div class="mt-20 text-center">
          <h3 class="font-headline font-bold text-2xl text-slate-900 mb-4">Want to be next?</h3>
          <p class="text-slate-500 mb-8">We're accepting new projects for Q3 2026.</p>
          <a href="/apply" class="inline-flex items-center gap-2 px-7 py-3.5 bg-accent-indigo text-white font-semibold rounded-lg hover:bg-accent-indigo/90 transition-colors">
            Apply for a Project
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
