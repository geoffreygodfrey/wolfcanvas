---
import WhatsApp from './WhatsApp.astro';
---

<div id="whatsapp-trigger"></div>
<WhatsApp />
<footer class="bg-slate-950 text-white">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center font-headline font-bold text-lg tracking-tight mb-4">
          <img src="/loggo.svg" alt="WolfCanvas" width="119" height="65" class="h-[65px] w-auto" />
          <span class="-ml-10">WolfCanvas</span>
        </a>
        <p class="text-white/40 text-sm font-light leading-relaxed max-w-sm">
          Conversion-focused websites for real estate brokerages. We build pages that turn property visitors into qualified buyer enquiries.
        </p>
      </div>
      <div>
        <h4 class="font-semibold text-sm mb-4">Pages</h4>
        <div class="space-y-2.5">
          <a href="/work" class="block text-sm font-light text-white/40 hover:text-white transition-colors">Work</a>
          <a href="/process" class="block text-sm font-light text-white/40 hover:text-white transition-colors">Process</a>
          <a href="/apply" class="block text-sm font-light text-white/40 hover:text-white transition-colors">Apply</a>
        </div>
      </div>
      <div>
        <h4 class="font-semibold text-sm mb-4">Legal</h4>
        <div class="space-y-2.5">
          <a href="/privacy" class="block text-sm font-light text-white/40 hover:text-white transition-colors">Privacy Policy</a>
        </div>
      </div>
      <div>
        <h4 class="font-semibold text-sm mb-4">Contact</h4>
        <div class="space-y-2.5">
          <a href="mailto:support@wolfcanvas.com" class="flex items-center gap-2 text-sm font-light text-white/40 hover:text-white transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
            support@wolfcanvas.com
          </a>
          <a href="https://www.instagram.com/wolfcanvas.design/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm font-light text-white/40 hover:text-white transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 8.25V6a2.25 2.25 0 00-2.25-2.25H6A2.25 2.25 0 003.75 6v8.25A2.25 2.25 0 006 16.5h2.25m8.25-8.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-7.5A2.25 2.25 0 018.25 18v-1.5m8.25-8.25h-3a4.5 4.5 0 00-4.5 4.5v3" /></svg>
            Instagram
          </a>
          <a href="https://www.facebook.com/wolfcanvas/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm font-light text-white/40 hover:text-white transition-colors">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75 0 4.487 3.035 8.266 7.125 9.488l.094-.047a.75.75 0 01.375-.09V15a.75.75 0 01.75-.75h.375c.728 0 1.238-.773 1.238-1.5 0-.621-.504-1.125-1.125-1.125H12a.75.75 0 01-.75-.75V9.75a1.875 1.875 0 011.875-1.875H15a.75.75 0 01.75.75v.75a.75.75 0 01-.75.75h-.75a.75.75 0 00-.75.75v.75c0 .414.336.75.75.75H16.5a.75.75 0 01.727.545A9.755 9.755 0 0021.75 12c0-5.385-4.365-9.75-9.75-9.75z" /></svg>
            Facebook
          </a>
        </div>
        <p class="text-xs font-light text-white/30 leading-relaxed mt-4 max-w-44">
          Near Titan World, Phase 7, Sector 61, Sahibzada Ajit Singh Nagar, Punjab 160062
        </p>
      </div>
    </div>
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <span class="text-xs font-light text-white/30">&copy; 2026 WolfCanvas. All rights reserved.</span>
      <span class="text-xs font-light text-white/30">Designed to generate enquiries, not just look good.</span>
    </div>
  </div>
</footer>
