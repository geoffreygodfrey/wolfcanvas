---
const isApply = Astro.url.pathname.startsWith('/apply');
---
{isApply ? null : (
  <div
    id="chat-root"
    class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3"
  >
    <!-- Popup teaser (first visit) -->
    <div id="chat-pop" class="hidden relative max-w-[250px] rounded-2xl rounded-br-sm border border-white/10 bg-[#0D1526]/95 backdrop-blur-xl shadow-xl shadow-black/40 p-4">
      <button id="chat-pop-close" type="button" aria-label="Dismiss message" class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white/60 hover:text-white transition-colors">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <p class="text-sm text-white/80 leading-snug">Need help turning more visitors into enquiries? Chat with us — a real person replies.</p>
    </div>

    <!-- Chat panel -->
    <div
      id="chat-panel"
      class="hidden w-[340px] sm:w-[360px] max-w-[calc(100vw-3rem)] rounded-2xl border border-white/10 bg-[#0D1526]/95 backdrop-blur-xl shadow-2xl shadow-black/50 overflow-hidden"
      role="dialog"
      aria-label="Chat with WolfCanvas"
    >
      <!-- Header -->
      <div class="flex items-center justify-between px-4 py-3.5 border-b border-white/10 bg-white/[0.03]">
        <div class="flex items-center gap-3">
          <div class="relative">
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-accent-indigo to-accent-cyan flex items-center justify-center font-headline font-bold text-white text-sm">W</div>
            <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-emerald-500 border-2 border-[#0D1526]"></span>
          </div>
          <div>
            <p class="text-sm font-semibold text-white leading-tight">WolfCanvas</p>
            <p class="text-[11px] text-emerald-400">Usually replies within a few minutes</p>
          </div>
        </div>
        <button id="chat-close" type="button" aria-label="Close chat" class="w-8 h-8 rounded-full hover:bg-white/10 flex items-center justify-center text-white/50 hover:text-white transition-colors">
          <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <!-- Body -->
      <div class="p-4">
        <div class="flex mb-4">
          <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-white/[0.06] border border-white/10 px-3.5 py-3">
            <p class="text-sm text-white/80 leading-relaxed">
              Hi, thanks for reaching out to WolfCanvas. Leave your WhatsApp number and we'll get back to you personally about your project.
            </p>
          </div>
        </div>

        <form id="chat-form" class="space-y-3" novalidate>
          <div>
            <label class="block text-xs font-medium text-white/60 mb-1.5" for="chat-phone">Phone / WhatsApp number *</label>
            <input
              id="chat-phone"
              name="phone"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              required
              placeholder="e.g. +1 (415) 555-0132"
              class="w-full px-3.5 py-2.5 rounded-lg border border-white/10 bg-white/[0.04] text-white text-sm placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all"
            />
            <p id="chat-phone-error" class="hidden mt-1.5 text-xs text-rose-400">Please enter a valid phone number.</p>
          </div>

          <div>
            <label class="block text-xs font-medium text-white/60 mb-1.5" for="chat-name">Your name (optional)</label>
            <input
              id="chat-name"
              name="name"
              type="text"
              autocomplete="name"
              placeholder="Your full name"
              class="w-full px-3.5 py-2.5 rounded-lg border border-white/10 bg-white/[0.04] text-white text-sm placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-accent-indigo/20 focus:border-accent-indigo transition-all"
            />
          </div>

          <label class="flex items-start gap-2.5 cursor-pointer" for="chat-optin">
            <input id="chat-optin" name="optin" type="checkbox" required class="mt-0.5 w-4 h-4 shrink-0 rounded border-white/20 bg-white/5 checked:bg-accent-indigo accent-accent-indigo" />
            <span class="text-[11px] leading-relaxed text-white/45">
              I agree to receive WhatsApp messages from WolfCanvas about my enquiry. Message and data rates may apply. I can opt out at any time.
            </span>
          </label>

          <button type="submit" class="w-full py-3 bg-accent-indigo text-white text-sm font-semibold rounded-lg hover:bg-accent-indigo/90 transition-colors flex items-center justify-center gap-2">
            Start chat
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </button>
        </form>
      </div>
    </div>

    <!-- Launcher button -->
    <button
      id="chat-fab"
      type="button"
      aria-label="Chat with WolfCanvas"
      class="relative w-14 h-14 rounded-full bg-gradient-to-br from-accent-indigo to-accent-cyan hover:from-accent-indigo-dark hover:to-accent-cyan shadow-lg shadow-accent-indigo/30 hover:shadow-xl transition-all group flex items-center justify-center"
    >
      <svg id="chat-fab-open" class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C6.477 2 2 6.253 2 11.5c0 2.2.75 4.235 2.017 5.9L2.25 21l4.02-1.3A10.1 10.1 0 0012 21c5.523 0 10-4.253 10-9.5S17.523 2 12 2zm.5 13.25H8a.75.75 0 010-1.5h4.5a.75.75 0 010 1.5zm3.5-3.5H8a.75.75 0 010-1.5h8a.75.75 0 010 1.5zm0-3.5H8a.75.75 0 010-1.5h8a.75.75 0 010 1.5z"/>
      </svg>
      <svg id="chat-fab-close" class="hidden w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-slate-950"></span>
    </button>
  </div>
)}

<script>
  const root = document.getElementById('chat-root');
  if (root) {
    const fab = document.getElementById('chat-fab');
    const panel = document.getElementById('chat-panel');
    const closeBtn = document.getElementById('chat-close');
    const form = document.getElementById('chat-form');
    const phoneInput = document.getElementById('chat-phone');
    const nameInput = document.getElementById('chat-name');
    const optIn = document.getElementById('chat-optin');
    const phoneError = document.getElementById('chat-phone-error');
    const fabOpenIcon = document.getElementById('chat-fab-open');
    const fabCloseIcon = document.getElementById('chat-fab-close');
    const pop = document.getElementById('chat-pop');
    const popClose = document.getElementById('chat-pop-close');

    const dismissPop = () => {
      pop.classList.add('hidden');
      try { sessionStorage.setItem('wc-chat-pop-seen', '1'); } catch (e) {}
    };

    let popShown = false;
    try { popShown = sessionStorage.getItem('wc-chat-pop-seen') === '1'; } catch (e) {}
    if (!popShown) {
      setTimeout(() => {
        pop.classList.add('chat-pop');
        pop.classList.remove('hidden');
      }, 2500);
    }
    popClose.addEventListener('click', dismissPop);
    pop.addEventListener('click', (event) => {
      if (event.target !== popClose) {
        dismissPop();
        openPanel();
      }
    });

    const openPanel = () => {
      dismissPop();
      panel.classList.remove('hidden');
      fabOpenIcon.classList.add('hidden');
      fabCloseIcon.classList.remove('hidden');
      fab.setAttribute('aria-label', 'Close chat');
    };
    const closePanel = () => {
      panel.classList.add('hidden');
      fabOpenIcon.classList.remove('hidden');
      fabCloseIcon.classList.add('hidden');
      fab.setAttribute('aria-label', 'Chat with WolfCanvas');
    };

    fab.addEventListener('click', () => {
      panel.classList.contains('hidden') ? openPanel() : closePanel();
    });
    closeBtn.addEventListener('click', closePanel);

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const digits = phoneInput.value.replace(/\D/g, '');
      if (digits.length < 7) {
        phoneError.classList.remove('hidden');
        phoneInput.focus();
        return;
      }
      phoneError.classList.add('hidden');

      const name = nameInput.value.trim();
      const text =
        (name ? `Hi WolfCanvas, I'm ${name}. ` : 'Hi WolfCanvas, ') +
        `My number is ${phoneInput.value.trim()}. I'd like to discuss improving my website's conversion rate.`;
      window.open(
        'https://wa.me/918264168690?text=' + encodeURIComponent(text),
        '_blank',
        'noopener,noreferrer'
      );
      closePanel();
      form.reset();
    });
  }
</script>

<style>
  @keyframes chatPopIn {
    from { opacity: 0; transform: translateY(8px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .chat-pop { animation: chatPopIn 350ms ease-out; }
</style>